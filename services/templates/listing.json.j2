{
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  {#- name = <provider>/<bare> per the platform service-naming convention
      (unitysvc #1196 / #1138). provider_name is injected from provider.json. #}
  "name": "{{ provider_name }}/{{ offering_name }}",
  {#- Channel-keyed price: byok is free (the customer's own key pays AionLabs
      directly); managed resells AionLabs tokens at the per-model rate carried in
      the param `list_price`. Channel keys MUST match the offering channels.

      Price-cell copy follows the marketplace description grammar
      (unitysvc/unitysvc#1886, PR #1887):

          <amount> [ ("/"|"per") <unit> ] [ "~"[intent] <badge> ]* [ "|" <note> ]

      The description that matters is the one on the CHANNEL price, not the
      sub-channel ones. CatalogServiceRow hands the whole `list_price` to
      PriceTag, and PriceTag is the only component that parses a description;
      the sub-channel prices reach ChannelDisplay's PriceBadge, which prints
      whatever it is given verbatim. A channel-keyed price carrying neither a
      top-level `description` nor a top-level `price` falls through PriceTag's
      structured branch to `isFree`, so all four models here render a green
      "Free" today even though the default channel is metered.

      "Pricing Per 1M Input/Output Tokens: $0.8/$1.6" is a rate card, and the
      grammar refuses to split two prices on purpose — it fails the unit test
      (currency in the tail) and falls through as ONE long unstyled amount. So
      the cell leads with the input rate, names "1M input tokens" as its unit
      so the figure can't be misread as covering both directions, and puts the
      output rate in the `|` note, which is terminal and taken verbatim.

      NO BYOK BADGE, deliberately, and this catalog is the clearest case for
      why: these services are available BOTH metered (managed, the default) and
      BYOK. The amount rendered beside any badge here is the managed rate, so a
      bare `~` badge — the green "this is a saving" register — would claim a
      discount on a number the customer pays in full. `~info BYOK` would be
      merely redundant rather than wrong, but the row already carries a byok
      access-method chip (AccessMethodBadges renders one per channel type,
      filterable and with its own lock glyph), so the affordance is already
      stated where it belongs. A BYOK pill belongs on a price cell whose amount
      really is Free — a BYOK-only catalog like unitysvc-services-deepseek —
      not on a metered one. The byok option goes in the `|` note instead.

      Composed here rather than in the param files because the populate
      workflow (.github/workflows/populate-services.yml) rewrites them and
      would drop a hand-edited description. `payout_price` is seller-facing
      (revenue_share, "No platform commission") and is deliberately untouched. #}
{#- The cell spans BOTH channels, so it leads with the range "Free - $x/$y"
    rather than picking one. Rates are joined with "/" and NO surrounding
    spaces: the parser's amount/unit separator requires whitespace on both
    sides, so " / " before the unit stays the only split point. Written as
    "$0.92 / $1.84" it would split at the first slash and reject the tail for
    carrying a currency symbol, collapsing onto one unstyled line. #}
{%- set _byok_note = ' | Free on the byok channel - your own key pays ' ~ provider_display_name ~ ' directly. The managed channel bills UnitySVC at the listed rate.' %}
{%- if list_price.input and list_price.output %}
{%- set _cell = 'Free - $' ~ list_price.input ~ '/$' ~ list_price.output ~ ' / 1M input/output tokens' ~ _byok_note %}
{%- set _managed = '$' ~ list_price.input ~ '/$' ~ list_price.output ~ ' / 1M input/output tokens' %}
{%- elif list_price.price %}
{%- set _cell = 'Free - $' ~ list_price.price ~ ' / 1M tokens' ~ _byok_note %}
{%- set _managed = '$' ~ list_price.price ~ ' per 1M tokens' %}
{%- endif %}
  "list_price": {
    "type": "channel",
    "default": "managed",
{%- if _cell %}
    "description": {{ _cell | tojson }},
{%- endif %}
    "channels": {
      "byok": {
        "description": "Free — bring your own {{ provider_display_name }} API key; you pay {{ provider_display_name }} directly for tokens",
        "price": "0",
        "type": "constant"
      },
      "managed": {{ dict(list_price, description=_managed) | tojson if _managed else list_price | tojson }}
    }
  },
  "user_access_interfaces": {
    "provider_api": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/{{ provider_name }}",
      "routing_key": {"model": "{{ details.model_name }}"}
    }
  },
  "documents": {
    "Aion Labs API docs": {
      "category": "api_reference",
      "external_url": "https://www.aionlabs.ai/api/docs/",
      "is_active": true,
      "is_public": true,
      "mime_type": "url"
    },
    "Aion Labs documentation": {
      "category": "api_reference",
      "external_url": "https://www.aionlabs.ai/documentation/",
      "is_active": true,
      "is_public": true,
      "mime_type": "url"
    },
    "How to use this model": {
      "$doc_preset": "llm_description"
    },
    "Connectivity test": {
      "$doc_preset": "llm_connectivity"
    },
    "Default request body": {
      "$doc_preset": "llm_request_template"
    },
    "Python code example (OpenAI SDK)": {
      "$doc_preset": "llm_code_example_openai"
    },
    "JavaScript code example": {
      "$doc_preset": "llm_code_example_javascript"
    },
    "cURL code example": {
      "$doc_preset": "llm_code_example_shell"
    },
    "Python function calling code example": {
      "$doc_preset": "llm_code_example_fc_requests"
    },
    {#- Anthropic-dialect examples exercise the llm_translator, which lives at
        the gateway; specs run-tests hits the OpenAI upstream directly (no
        translator), so their automated probe is skipped. They remain valid,
        published examples and are covered by the gateway's translator e2e. -#}
    "Python code example (Anthropic style)": {
      "$doc_preset": {
        "name": "llm_code_example_anthropic_to_openai_requests",
        "meta": {"test": {"status": "skip"}}
      }
    },
    "cURL code example (Anthropic style)": {
      "$doc_preset": {
        "name": "llm_code_example_anthropic_to_openai_shell",
        "meta": {"test": {"status": "skip"}}
      }
    }
  }
}
