{
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  {#- name = <provider>/<bare> per the platform service-naming convention
      (unitysvc #1196 / #1138). provider_name is injected from provider.json. #}
  "name": "{{ provider_name }}/{{ offering_name }}",
  {#- Channel-keyed price: byok is free (the customer's own key pays AionLabs
      directly); managed resells AionLabs tokens at the per-model rate carried in
      the param `list_price`. Channel keys MUST match the offering channels. #}
  "list_price": {
    "type": "channel",
    "default": "managed",
    "channels": {
      "byok": {
        "description": "Free — bring your own {{ provider_display_name }} API key; you pay {{ provider_display_name }} directly for tokens",
        "price": "0",
        "type": "constant"
      },
      "managed": {{ list_price | tojson }}
    }
  },
  "user_access_interfaces": {
    "provider_api": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/{{ provider_name }}",
      "routing_key": {"model": "{{ details.model_name }}"}
    }
  },
  "documents": {
    "Aion Labs API docs": {
      "category": "api_reference",
      "external_url": "https://www.aionlabs.ai/api/docs/",
      "is_active": true,
      "is_public": true,
      "mime_type": "url"
    },
    "Aion Labs documentation": {
      "category": "api_reference",
      "external_url": "https://www.aionlabs.ai/documentation/",
      "is_active": true,
      "is_public": true,
      "mime_type": "url"
    },
    "How to use this model": {
      "$doc_preset": "llm_description"
    },
    "Connectivity test": {
      "$doc_preset": {"name": "llm_connectivity", "meta": {"sleep_after_test": 5}}
    },
    "Default request body": {
      "$doc_preset": "llm_request_template"
    },
    "Python code example (OpenAI SDK)": {
      "$doc_preset": {"name": "llm_code_example_openai", "meta": {"sleep_after_test": 5}}
    },
    "JavaScript code example": {
      "$doc_preset": {"name": "llm_code_example_javascript", "meta": {"sleep_after_test": 5}}
    },
    "cURL code example": {
      "$doc_preset": {"name": "llm_code_example_shell", "meta": {"sleep_after_test": 5}}
    },
    "Python function calling code example": {
      "$doc_preset": {"name": "llm_code_example_fc_requests", "meta": {"sleep_after_test": 5}}
    },
    {#- Anthropic-dialect examples, authored locally for now (to be promoted to
        unitysvc-data presets once proven). They branch on local_testing: the
        upstream is OpenAI-native, so specs run-tests calls it in OpenAI form,
        while gateway (services run-tests) speaks Anthropic and exercises the
        llm_translator end to end. -#}
    "Python code example (Anthropic SDK)": {
      "category": "code_example",
      "description": "Anthropic Messages API via the anthropic SDK; the gateway translates to the OpenAI upstream",
      "file_path": "anthropic-to-openai-code-example.py.j2",
      "is_active": true,
      "is_public": true,
      "mime_type": "python",
      "meta": {"requirements": ["openai", "anthropic"], "sleep_after_test": 5}
    },
    "cURL code example (Anthropic style)": {
      "category": "code_example",
      "description": "Anthropic Messages API via cURL; the gateway translates to the OpenAI upstream",
      "file_path": "anthropic-to-openai-code-example.sh.j2",
      "is_active": true,
      "is_public": true,
      "mime_type": "bash",
      "meta": {"sleep_after_test": 5}
    }
  }
}
